# Admin login configuration
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-long-password
# Generate a random 32+ character value. Never commit the real value.
ADMIN_AUTH_SECRET=replace-with-a-random-secret

# Existing integrations
DATABASE_URL=
# Direct, unpooled Neon URL used only by Drizzle migrations.
DATABASE_URL_UNPOOLED=
BLOB_READ_WRITE_TOKEN=
# Public canonical URL used by sitemap and RSS.
BETTER_AUTH_URL=http://localhost:3000
